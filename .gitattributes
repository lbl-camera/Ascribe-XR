# Git LFS tracking for large binary files
*.res filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
# .glb meshes here are all small (<64 KB); keep them in standard git, not LFS
*.zip filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.r16 filter=lfs diff=lfs merge=lfs -text
# Large scene files with embedded volume/terrain data
/specimens/sanfrancisco_topography.tscn filter=lfs diff=lfs merge=lfs -text
/specimens/ceramic.tscn filter=lfs diff=lfs merge=lfs -text
/specimens/brainvolume.tscn filter=lfs diff=lfs merge=lfs -text
/specimens/rockneutron.tscn filter=lfs diff=lfs merge=lfs -text
rec_plant.tscn filter=lfs diff=lfs merge=lfs -text
# Large specimen-data .tres volume files (explicit paths to avoid blanket *.tres)
specimen_data/rock_ct.tres filter=lfs diff=lfs merge=lfs -text
specimen_data/rec_plant.tres filter=lfs diff=lfs merge=lfs -text
specimen_data/bin_rec_plant.tres filter=lfs diff=lfs merge=lfs -text
specimen_data/pem_electrolizer.tres filter=lfs diff=lfs merge=lfs -text
specimen_data/terrain/assets.tres filter=lfs diff=lfs merge=lfs -text
# Large mesh JSON files (too big for plain text but JSON typically isn't LFS-tracked globally)
specimen_data/cthead_mesh.json filter=lfs diff=lfs merge=lfs -text
specimen_data/cthead-8bit/cthead_mesh.json filter=lfs diff=lfs merge=lfs -text

